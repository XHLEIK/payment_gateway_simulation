# Next.js dependency folders
/node_modules
/.pnp
.pnp.*

# Yarn configuration caches
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Automated test coverage results
/coverage

# Next.js build compilation outputs
/.next/
/out/
/build

# OS clutter and local certificate keys
.DS_Store
*.pem

# Package manager execution logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment secret variables
.env*
.vercel

# TypeScript incremental compilation caches
*.tsbuildinfo
next-env.d.ts
