						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.orderId) {",
									"    pm.environment.set(\"orderId\", response.orderId);",
									"    pm.environment.set(\"signature\", response.signature);",
